{
  "publisher": "Duda Duarte",
  "icon": "assets/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/dudaduarte07/xpath-doctor"
  },
  "categories": [
    "Other",
    "Programming Languages",
    "Linters"
  ],
  "keywords": [
    "xpath",
    "scrapy",
    "web scraping",
    "crawler",
    "selector",
    "html",
    "xml"
  ],
  "name": "xpath-doctor",
  "displayName": "xpath-doctor",
  "description": "Analyze XPath expressions and detect fragile selectors.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.120.0"
  },
  
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
  "commands": [
    {
      "command": "xpath-doctor.analyzeSelectedXPath",
      "title": "XPath Doctor: Analyze Selected XPath"
    }
  ],
  "menus": {
    "editor/context": [
      {
        "command": "xpath-doctor.analyzeSelectedXPath",
        "when": "editorHasSelection",
        "group": "navigation"
      }
    ]
  }
},
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.120.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.56.1",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}
